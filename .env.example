# ==========================================
# Alpaca Trading API Configuration (Paper)
# ==========================================
APCA_API_KEY_ID=your_alpaca_api_key_id_here
APCA_API_SECRET_KEY=your_alpaca_api_secret_key_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets/v2

# ==========================================
# Reasoning Engines (Featherless / Ollama / OpenClaude)
# ==========================================
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
OLLAMA_BASE_URL=http://localhost:11434
REASONING_MODEL=llama3.1
OPENCLAUDE_API_KEY=

# ==========================================
# Risk Parameters (FinRL-X Monitoring)
# ==========================================
INITIAL_PORTFOLIO_EQUITY=100000.00
MAX_DRAWDOWN_THRESHOLD=0.025
HEDGE_TARGET_SYMBOL=SPY
DEFAULT_HEDGE_DELTA=-0.35
MAX_HEDGE_BUDGET_PCT=0.015

# ==========================================
# Cloud Run & FastMCP Server Configuration
# ==========================================
HOST=0.0.0.0
PORT=8080
MCP_TRANSPORT=sse
LOG_LEVEL=INFO
